# ======================================================
# DrumCourse — шаблон переменных окружения
# Скопируйте этот файл в .env и заполните значения
# НИКОГДА не коммитьте .env в git
# ======================================================

# --- Django ---
SECRET_KEY=замените-на-случайную-строку-длиной-50-символов
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,ваш-домен.com

# --- CORS (адрес фронтенда, через запятую) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Telegram ---
TELEGRAM_BOT_TOKEN=ваш-токен-бота
TELEGRAM_CHAT_ID=ваш-chat-id

# --- Email (SMTP) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ваш-адрес@gmail.com
EMAIL_HOST_PASSWORD=ваш-app-password
DEFAULT_FROM_EMAIL=DrumCourse <ваш-адрес@gmail.com>

# --- WhatsApp OTP ---
# Варианты провайдера: console (для разработки), twilio
WHATSAPP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
